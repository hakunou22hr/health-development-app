# Backend only. Never prefix secrets with VITE_.
GEMINI_API_KEY=
# Confirm free-tier availability in Google AI Studio before enabling.
GEMINI_MODEL=gemini-3.5-flash-lite
# Explicitly acknowledge using a Google project WITHOUT paid billing.
GEMINI_FREE_PROJECT_CONFIRMED=false
PORT=8787
HOST=127.0.0.1
# Public hosting: set the application's exact HTTPS origin and an access passphrase.
APP_ORIGIN=http://localhost:8787
APP_ACCESS_TOKEN=
# Optional modest local limits (these are NOT guarantees of Google's billing/quota).
DAILY_ANALYSIS_LIMIT=20
MINUTE_ANALYSIS_LIMIT=3
